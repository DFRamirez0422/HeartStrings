  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 213903422}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1f52624f7848bc42864aa0896c08652, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBox: {fileID: 1437676594}
  dialogueText: {fileID: 293847348}
  questionBox: {fileID: 1437676594}
  questionText: {fileID: 293847348}
  answerButtons:
  - {fileID: 1531244610}
  - {fileID: 78181992}
  - {fileID: 846034147}
  answerButtonTexts:
  - {fileID: 1108707437}
  - {fileID: 1873611403}
  - {fileID: 1879969926}
  allVisualGroups:
  - {fileID: 590937568}
  - {fileID: 1364302735}
  - {fileID: 1215476337}
  - {fileID: 1109903006}
  - {fileID: 1497130727}
  - {fileID: 1749336665}
  - {fileID: 158400148}
  - {fileID: 1378918513}
  - {fileID: 1867235398}
  - {fileID: 1280684043}
  - {fileID: 2053386220}
  - {fileID: 1526982930}
  - {fileID: 1939518}
  nextButton: {fileID: 1015302479}
  questions:
  - visualGroup: {fileID: 590937568}
    teachingLines:
    - 'The sun sets as the festival begins to glow.

      Daniel climbs to the rooftop
      to continue practicing.'
    - 'Below him, candles are lit across the town.

      People paint their faces
      for the night ahead.'
    - "He wonders if the face paint could hide \nhis fear. Maybe behind the mask,
      \nhe could feel brave enough to play."
    - "In this level, you will learn note names \nand simple chords. You will learn
      how\nMajor chords can feel bright and hopeful,\nand Minor chords softer and
      more emotional."
    - Let's Begin!
    - "Musical notes are named using the letters \nA, B, C, D, E, F, and G.\r\nAfter
      G, the notes repeat back to A."
    questionText: What letter comes after G in music?
    answerA: F
    answerB: A
    answerC: H
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nAfter G, the notes repeat back to A."
    incorrectFeedbackLines:
    - "Not quite. \nMusical notes only use A through G. \nAfter G, the notes repeat
      back to A.\nTry again."
  - visualGroup: {fileID: 1364302735}
    teachingLines:
    - "Notes can be placed in the spaces of the staff. \nThe spaces spell F, A, C,
      and E from bottom to top. \nRemember: the spaces spell FACE."
    questionText: What letter is the second note on the staff?
    answerA: F
    answerB: A
    answerC: C
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThe spaces spell F, A, C, E,\nso the second space is A."
    incorrectFeedbackLines:
    - "Not quite. \nThe spaces on the staff are F, A, C, and E. \nThe second space
      is A.\nTry again."
  - visualGroup: {fileID: 1364302735}
    teachingLines:
    - "The spaces on the staff are F, A, C, and E. \nEach space has its own note
      name. \nCounting the spaces from bottom to top \nwill help you find the correct
      note."
    questionText: What letter is the fourth note on the staff?
    answerA: E
    answerB: F
    answerC: C
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThe spaces spell F, A, C, E, \nso the fourth space is E."
    incorrectFeedbackLines:
    - "Not quite. \nThe spaces on the staff are F, A, C, and E. \nThe fourth space
      is E.\nTry again."
  - visualGroup: {fileID: 1215476337}
    teachingLines:
    - "Notes can also be placed on the lines of the staff. \nThe lines are E, G,
      B, D, and F from bottom to top. \nRemember: Every Good Boy Deserves Fudge."
    questionText: What letter is the first line at the bottom of the staff?
    answerA: F
    answerB: E
    answerC: G
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThe first line at the bottom of the staff is E."
    incorrectFeedbackLines:
    - "Not quite. \nThe staff lines are E, G, B, D, and F \nfrom bottom to top. The
      first line is E.\nTry again."
  - visualGroup: {fileID: 1215476337}
    teachingLines:
    - "The staff lines are E, G, B, D, and F. \nEach line has its own note name.
      \nCounting from the bottom line upward \nwill help you read the note correctly."
    questionText: What letter is the third line of the staff?
    answerA: E
    answerB: B
    answerC: D
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThe third line of the staff is B."
    incorrectFeedbackLines:
    - "Not quite. \nThe staff lines are E, G, B, D, and F \nfrom bottom to top. The
      third line is B.\nTry again."
  - visualGroup: {fileID: 1215476337}
    teachingLines:
    - "The top line of the staff is the fifth line. \nThe lines from bottom to top
      are E, G, B, D, F. \nRemember: Every Good Boy Deserves Fudge!"
    questionText: What letter is the fifth line at the top of the staff?
    answerA: E
    answerB: F
    answerC: B
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThe fifth line at the top of the staff is F."
    incorrectFeedbackLines:
    - "Not quite. \nThe staff lines are E, G, B, D, and F \nfrom bottom to top. The
      fifth line is F.\nTry again."
  - visualGroup: {fileID: 1109903006}
    teachingLines:
    - "Each note has its own letter name.\nThe better you read the notes, \nthe closer
      you get to writing a song!"
    questionText: What note is this?
    answerA: C
    answerB: E
    answerC: G
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThis note is C."
    incorrectFeedbackLines:
    - "Not quite. \nThis note is C.\nTry again."
  - visualGroup: {fileID: 1497130727}
    teachingLines:
    - "Look carefully at the note shown \nbefore choosing your answer."
    questionText: What note is this?
    answerA: A
    answerB: B
    answerC: E
    correctAnswerIndex: 2
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThis note is E."
    incorrectFeedbackLines:
    - "Not quite. \nThis note is E.\nTry again."
  - visualGroup: {fileID: 1749336665}
    teachingLines:
    - "Look carefully at the note shown \nbefore choosing your answer."
    questionText: What note is this?
    answerA: B
    answerB: C
    answerC: G
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThis note is B."
    incorrectFeedbackLines:
    - "Not quite. \nThis note is B.\nTry again."
  - visualGroup: {fileID: 158400148}
    teachingLines:
    - "Look carefully at the note shown \nbefore choosing your answer."
    questionText: What note is this?
    answerA: F
    answerB: G
    answerC: A
    correctAnswerIndex: 2
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThis note is A."
    incorrectFeedbackLines:
    - "Not quite. \nThis note is A.\nTry again."
  - visualGroup: {fileID: 1378918513}
    teachingLines:
    - "A chord is when multiple notes are played \ntogether. Chords make music sound
      fuller than \na single note. Daniel can use chords to make \nhis serenade feel
      warmer and more emotional."
    questionText: What is a chord made from?
    answerA: Multiple notes
    answerB: One staff line
    answerC: Three beats
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nA chord is made from \nmultiple notes played together."
    incorrectFeedbackLines:
    - "Not quite. \nA chord is made from \nmultiple notes played together.\nTry again."
  - visualGroup: {fileID: 1378918513}
    teachingLines:
    - "In this game, simple chords are built with \nthree notes. When three notes
      are played \ntogether, they create one fuller sound."
    - "These three-note chords will help \nDaniel give the serenade more feeling."
    questionText: "How many notes are in the \nsimple chords we are learning?"
    answerA: 1 note
    answerB: 3 notes
    answerC: 7 notes
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nIn this game, \nsimple chords use 3 notes."
    incorrectFeedbackLines:
    - "Not quite. \nIn this game, \nsimple chords use 3 notes.\nTry again."
  - visualGroup: {fileID: 1378918513}
    teachingLines:
    - "Major chords usually sound bright, \nhappy, or hopeful. They can make \nthe
      serenade feel warm and romantic. "
    - "The C Major chord is made \nfrom the notes C, E, and G.\r\n"
    questionText: Which chord is shown?
    answerA: C Minor
    answerB: C Major
    answerC: G Major
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nC, E, and G make\nthe C Major chord."
    incorrectFeedbackLines:
    - "Not quite. \nC, E, and G make\nthe C Major chord.\nTry again."
  - visualGroup: {fileID: 1867235398}
    teachingLines:
    - "Different major chords use different groups \nof notes. Even when the notes
      change, major \nchords usually keep a bright or hopeful feeling. \nThe G Major
      chord is the notes G, B, and D.\r\n"
    questionText: Which chord is shown?
    answerA: C Major
    answerB: G Major
    answerC: A Major
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nG, B, and D make a G Major chord."
    incorrectFeedbackLines:
    - "Not quite. \nG, B, and D make a G Major chord.\nTry again."
  - visualGroup: {fileID: 1280684043}
    teachingLines:
    - "Minor chords usually sound softer, darker, \nor more emotional. They can make
      the serenade \nfeel expressive without making it too sad. \nThe A Minor chord
      is the notes A, C, and E."
    questionText: Which chord is shown?
    answerA: A Minor
    answerB: C Major
    answerC: E Minor
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nA, C, and E make an A Minor chord."
    incorrectFeedbackLines:
    - "Not quite. \nA, C, and E make an A Minor chord.\nTry again."
  - visualGroup: {fileID: 2053386220}
    teachingLines:
    - "Minor chords are also built from three notes. \nChanging the note group changes
      the feeling \nof the chord. An E Minor chord is made \nfrom the notes E, G,
      and B."
    questionText: Which chord is shown?
    answerA: E Minor
    answerB: G Minor
    answerC: C Major
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nE, G, and B make an E Minor chord."
    incorrectFeedbackLines:
    - "Not quite. \nE, G, and B make an E Minor chord.\nTry again."
  - visualGroup: {fileID: 1526982930}
    teachingLines:
    - "Now you can recognize notes and simple chords. \nUse what you have learned
      to name the note \nshown on the staff. Reading notes will help \nDaniel finish
      the serenade with confidence."
    questionText: What note is this?
    answerA: A
    answerB: B
    answerC: C
    correctAnswerIndex: 1
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \n"
    incorrectFeedbackLines:
    - "Not quite. \n\nTry again."
  - visualGroup: {fileID: 2053386220}
    teachingLines:
    - "Chords are made from notes played together. \nLook carefully at the notes
      in the chord before \nchoosing your answer. The correct group of \nnotes will
      tell you the chord name."
    questionText: Which chord is shown?
    answerA: E Minor
    answerB: C Major
    answerC: D Minor
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nE, G, and B make an E Minor chord."
    incorrectFeedbackLines:
    - "Not quite. \nE, G, and B make an E Minor chord.\nTry again."
  - visualGroup: {fileID: 1939518}
    teachingLines:
    - "Look at the note shown \nand choose its correct name."
    questionText: What note is this?
    answerA: F
    answerB: E
    answerC: A
    correctAnswerIndex: 2
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nThis note is A."
    incorrectFeedbackLines:
    - "Not quite. \nThis note is A.\nTry again."
  - visualGroup: {fileID: 1280684043}
    teachingLines:
    - "Look at the chord shown \r\nand choose its correct name."
    questionText: Which chord is shown?
    answerA: A Minor
    answerB: E Minor
    answerC: E Major
    correctAnswerIndex: 0
    secondCorrectAnswerIndex: -1
    correctFeedbackLines:
    - "Correct! \nA, C, and E make an A Minor chord."
    incorrectFeedbackLines:
    - "Not quite. \nA, C, and E make an A Minor chord.\nTry again."
  typeSpeed: 0.04
